# 复制为 .env 后按需修改。start.sh / deploy.sh 会 source 本文件。
# 不要把 .env 提交进仓库。
#
# 路径默认全在本目录（server/）：
#   .venv / .venv-foley / .venv-upscale
#   models/  data/  logs/  .cache/
# Python 不写死：未设 WAN22_PYTHON 时从 PATH 找 python3，再找 python。
# vast.ai / AutoDL / 本机直接 ./deploy.sh && ./start.sh 即可。

# --- 接单（config.py）---
# 无队列：一次只跑一个任务，正在跑时再来的 POST 直接 429。
WAN22_UPLOAD_MAX_BYTES=10485760
# WAN22_TASK_DB=data/tasks.db

# 逗号分隔。精确匹配，或以 . 开头做后缀匹配（.cloudfront.net）。
# 空或不设则不限制 host（仍要求 https；图片拒绝私网）。测试先留空。
WAN22_IMAGE_HOSTS=

# 空或不设则不限制 webhook host（仍要求 https；允许内网，拒绝链路本地）。
WAN22_WEBHOOK_HOSTS=
# WAN22_WEBHOOK_SECRET=

WAN22_DOCS=0
WAN22_DRY_RUN=0
WAN22_PRELOAD=1
WAN22_HOST=0.0.0.0
WAN22_PORT=8000

# --- 可选：覆盖解释器 / 是否装 Torch ---
# 镜像自带 CUDA torch 时不要强行 WAN22_INSTALL_TORCH=1；deploy.sh 会探测。
# 探测到现成 torch+cuda 时会建 --system-site-packages 的 venv，避免再下一份。
# WAN22_PYTHON=/usr/bin/python3
# WAN22_INSTALL_TORCH=0
# WAN22_VENV_SYSTEM_SITE=1

# Hugging Face token。公开仓可以不填。
# HF_TOKEN=

# 国内机器再打开镜像。vast.ai / 海外不要设，否则更慢或失败。
# HF_ENDPOINT=https://hf-mirror.com
# WAN22_GITHUB_MIRROR=https://gitclone.com/github.com/
# WAN22_GHFAST=https://ghfast.top/
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

# --- 推理（config.py）---
WAN22_QUANT=int8wo
WAN22_TEXT_ENCODER_QUANT=int8wo
WAN22_OFFLOAD=none
WAN22_VAE_TILING=1
WAN22_STEPS=6
WAN22_GUIDANCE_SCALE=1.0
WAN22_GUIDANCE_SCALE_2=1.0
WAN22_NSFW_HIGH_SCALE=1.0
WAN22_NSFW_LOW_SCALE=1.0
WAN22_MAX_DIM=832
WAN22_MIN_DIM=480
WAN22_SQUARE_DIM=640
WAN22_FPS=16
WAN22_MAX_FRAMES=321
WAN22_VIDEO_QUALITY=6
WAN22_LOG_LEVEL=INFO
WAN22_LOG_BACKUP_DAYS=30
WAN22_LOG_CONSOLE=1

# --- Foley ---
# 第一次部署默认跳过。要配音：WAN22_FOLEY_SKIP=0 ./deploy.sh，再打开 ENABLE。
WAN22_FOLEY_SKIP=1
WAN22_FOLEY_ENABLE=0
WAN22_FOLEY_REQUIRED=0
WAN22_FOLEY_SIZE=xl
WAN22_FOLEY_STEPS=50
WAN22_FOLEY_GUIDANCE=4.5
WAN22_FOLEY_TIMEOUT=180

# --- 超分 ---
# 1080p = 720p 生成 + compact 超分（realesr-general-x4v3，4x 后再缩到 1.5x）。
WAN22_UPSCALE_SKIP=0
WAN22_UPSCALE_ENABLE=1
WAN22_UPSCALE_MODEL=realesr-general-x4v3.pth
WAN22_UPSCALE_SCALE=1.5
WAN22_UPSCALE_TIMEOUT=300

# --- 成片上传（config.py）---
# 凭证优先用机器 IAM Role；也可用 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY。
WAN22_S3_BUCKET=your-bucket
WAN22_S3_REGION=ap-northeast-1
WAN22_S3_PREFIX=wan22/
# CloudFront 或自定义域名。空则拼 s3 虚拟主机 URL。
WAN22_S3_PUBLIC_BASE_URL=https://dxxx.cloudfront.net
# WAN22_S3_ENDPOINT=

# --- GPU watchdog（ops/watchdog.sh 会 source 本文件）---
# WAN22_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# WAN22_FEISHU_SECRET=
# WAN22_SYSTEMD_UNIT=wan22-gpu
# WAN22_WATCHDOG_MEM_PCT=85
# WAN22_WATCHDOG_DISK_PCT=85
# WAN22_WATCHDOG_GPU_TEMP=85
# WAN22_WATCHDOG_COOLDOWN=1800
