# 复制为 .env 后按机器修改。start.sh / deploy.sh 会 source 本文件。
# 不要把 .env 提交进仓库。
#
# 检测到 /root/autodl-tmp 时自动走 AutoDL 布局（数据盘 + 镜像 conda Torch）。
# 现网 EC2 没有该目录，仍用 /opt venv 和 /data 权重。

# ElastiCache Serverless 用 rediss://（TLS）。List+String，哈希标签 {wan22}。
WAN22_REDIS_URL=rediss://your-elasticache:6379
WAN22_QUEUE_MAX=500
WAN22_MAX_ATTEMPTS=3
WAN22_UPLOAD_MAX_BYTES=10485760

# 逗号分隔。精确匹配，或以 . 开头做后缀匹配（.cloudfront.net）。
# 空或不设则不限制 host（仍要求 https；图片拒绝私网）。
WAN22_IMAGE_HOSTS=cdn.example.com,.cloudfront.net

# 空或不设则不限制 webhook host（仍要求 https；允许内网，拒绝链路本地）。
WAN22_WEBHOOK_HOSTS=api.example.com
# 可选。配置后回调带 X-Wan-Signature: sha256=...
# WAN22_WEBHOOK_SECRET=

WAN22_DOCS=0
WAN22_DRY_RUN=0
WAN22_PRELOAD=1

# --- AutoDL（RTX PRO 6000 测试机）---
# 系统盘 30G，权重/venv/日志必须在数据盘。
WAN22_LAYOUT=autodl
WAN22_DATA_ROOT=/root/autodl-tmp/wan22
WAN22_PYTHON=/root/miniconda3/bin/python
WAN22_VENV_DIR=/root/autodl-tmp/wan22/venv
WAN22_VENV_SYSTEM_SITE=1
WAN22_INSTALL_TORCH=0
WAN22_MODEL_DIR=/root/autodl-tmp/wan22/models/base/WAMU_v3_WAN2.2_I2V_LIGHTNING
WAN22_LORA_DIR=/root/autodl-tmp/wan22/models/loras
HF_HOME=/root/autodl-tmp/wan22/hf-cache
WAN22_DATA_DIR=/root/autodl-tmp/wan22/runtime
WAN22_LOG_DIR=/root/autodl-tmp/wan22/logs
WAN22_HOST=0.0.0.0
WAN22_PORT=8000

# 现网 EC2 把上面改成：
# WAN22_LAYOUT=ec2
# WAN22_VENV_DIR=/opt/wan22-venv
# WAN22_INSTALL_TORCH=1
# WAN22_MODEL_DIR=/data/models/wan22/base/WAMU_v3_WAN2.2_I2V_LIGHTNING
# WAN22_LORA_DIR=/data/models/wan22/loras
# HF_HOME=/data/hf-cache
# WAN22_DATA_DIR=./data
# WAN22_LOG_DIR=./logs
# WAN22_HOST=127.0.0.1

WAN22_QUANT=int8wo
WAN22_TEXT_ENCODER_QUANT=int8wo
WAN22_OFFLOAD=none
WAN22_VAE_TILING=1
WAN22_STEPS=6
WAN22_GUIDANCE_SCALE=1.0
WAN22_GUIDANCE_SCALE_2=1.0
WAN22_MAX_DIM=832
WAN22_MIN_DIM=480
WAN22_SQUARE_DIM=640
WAN22_FPS=16
WAN22_MAX_FRAMES=321
WAN22_VIDEO_QUALITY=6
WAN22_LOG_LEVEL=INFO
WAN22_LOG_BACKUP_DAYS=30
WAN22_LOG_CONSOLE=1

# Foley。AutoDL 第一次测试先跳过（系统盘/内存都紧）。
# 要装：WAN22_FOLEY_SKIP=0 ./deploy.sh，并打开 ENABLE。
WAN22_FOLEY_SKIP=1
WAN22_FOLEY_ENABLE=0
WAN22_FOLEY_REQUIRED=0
WAN22_FOLEY_VENV_DIR=/root/autodl-tmp/wan22/foley-venv
WAN22_FOLEY_PYTHON=/root/autodl-tmp/wan22/foley-venv/bin/python
WAN22_FOLEY_REPO=/root/autodl-tmp/wan22/HunyuanVideo-Foley
WAN22_FOLEY_MODEL_DIR=/root/autodl-tmp/wan22/models/hunyuanvideo-foley
WAN22_FOLEY_SIZE=xl
WAN22_FOLEY_PROMPT=intimate erotic Foley matching the video, soft sensual ambient music, sultry atmosphere, breathy room tone, no speech, no lyrics
WAN22_FOLEY_NEG_PROMPT=noisy, harsh, speech, lyrics, shouting
WAN22_FOLEY_STEPS=50
WAN22_FOLEY_GUIDANCE=4.5
WAN22_FOLEY_TIMEOUT=180

# 成片上传。凭证优先用机器 IAM Role；也可用 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY。
WAN22_S3_BUCKET=your-bucket
WAN22_S3_REGION=ap-northeast-1
WAN22_S3_PREFIX=wan22/
# CloudFront 或自定义域名。空则拼 s3 虚拟主机 URL。
WAN22_S3_PUBLIC_BASE_URL=https://dxxx.cloudfront.net
# 兼容 MinIO 等时才需要
# WAN22_S3_ENDPOINT=

# GPU watchdog（ops/watchdog.sh）。不设 webhook 则异常只打 stdout。
# WAN22_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# WAN22_FEISHU_SECRET=
# WAN22_SYSTEMD_UNIT=wan22-gpu
# WAN22_WATCHDOG_MEM_PCT=85
# WAN22_WATCHDOG_DISK_PCT=85
# WAN22_WATCHDOG_GPU_TEMP=85
# WAN22_WATCHDOG_COOLDOWN=1800
